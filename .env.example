# Copy to .env and fill in. Never commit .env (see AGENTS.md, Decision 004).
# Names only here; real values live in the server's env files and GitHub secrets.

# App
APP_NAME=EV Shortlist
# Canonical origin for hreflang links and sitemap.xml (web app; read at build time for static pages)
APP_URL=http://localhost:3000

# Database
# Web app: folder holding numbered catalogue releases (default ../../data/releases)
CATALOGUE_DIR=
# Web app: staff pages (/staff/review) return 404 unless this is 1. Keep 0 in production
# until staff auth exists.
STAFF_PAGES=0
# Web app: with STAFF_PAGES=1, staff pages need these HTTP Basic credentials ("user:pass").
# Unset = staff pages always answer 401 (fails closed). Dummy value; real one in server env only.
STAFF_BASIC_AUTH=staff:change-me
# Web app: folder holding the pipeline's review CSVs (default ../../data/review)
REVIEW_DIR=
# Web app: trip fit quick check (T-036). 1 shows "Find cars for my trips" on Explore; 0 hides it.
TRIP_FIT=0
# Web app (tests only): JSON file that replaces the charging link-out config (T-026 e2e fixture).
CHARGING_LINKS_FILE=

DATABASE_URL=postgres://evfinder:evfinder@localhost:5432/evfinder

# Auth (Better Auth)
AUTH_SECRET=change-me

# Email (Scaleway)
EMAIL_FROM=hello@example.com
EMAIL_API_KEY=

# Object storage for raw snapshots (Scaleway, S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Pipeline snapshot store for raw fetches (ev refresh, Decision 021): local (default) or s3.
# s3 uses the S3_* values above; it is an interface only for now.
SNAPSHOT_BACKEND=local
# Local snapshot folder (default data/snapshots, git-ignored)
SNAPSHOT_DIR=
# Key prefix inside the bucket for SNAPSHOT_BACKEND=s3
SNAPSHOT_S3_PREFIX=ev-finder/snapshots/
# Refresh run logs and source state (default data/runs, git-ignored)
EV_RUNS_DIR=

# Analytics (shared Umami)
UMAMI_WEBSITE_ID=

# Price sampling (layer 3): OFF until the legal check passes.
# Targets and rates come from private runtime config, never this repo.
PRICE_SAMPLING_ENABLED=false
PRICE_SAMPLING_CONFIG_URL=

# Bjørn Nyland test sheet (permission pending): CSV export URL, local fetch only.
# Output stays in data/local/nyland/ (git-ignored); never commit the URL or the data.
NYLAND_SHEET_CSV_URL=
