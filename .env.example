# Copy to .env and fill in. Never commit .env (see AGENTS.md, Decision 004).
# Names only here; real values live in the server's env files and GitHub secrets.

# App
APP_NAME=EV Finder
APP_URL=http://localhost:3000

# Database
# Web app: folder holding numbered catalogue releases (default ../../data/releases)
CATALOGUE_DIR=
# Web app: staff pages (/staff/review) return 404 unless this is 1. Keep 0 in production
# until staff auth exists.
STAFF_PAGES=0
# Web app: folder holding the pipeline's review CSVs (default ../../data/review)
REVIEW_DIR=

DATABASE_URL=postgres://evfinder:evfinder@localhost:5432/evfinder

# Auth (Better Auth)
AUTH_SECRET=change-me

# Email (Scaleway)
EMAIL_FROM=hello@example.com
EMAIL_API_KEY=

# Object storage for raw snapshots (Scaleway, S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Analytics (shared Umami)
UMAMI_WEBSITE_ID=

# Price sampling (layer 3): OFF until the legal check passes.
# Targets and rates come from private runtime config, never this repo.
PRICE_SAMPLING_ENABLED=false
PRICE_SAMPLING_CONFIG_URL=

# Bjørn Nyland test sheet (permission pending): CSV export URL, local fetch only.
# Output stays in data/local/nyland/ (git-ignored); never commit the URL or the data.
NYLAND_SHEET_CSV_URL=
