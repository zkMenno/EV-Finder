{
  "name": "@ev/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JSON Schema source of truth; generates TS types and Pydantic models.",
  "exports": {
    ".": "./generated/ts/index.ts",
    "./schema.json": "./schemas/ev.schema.json"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "5.5.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
