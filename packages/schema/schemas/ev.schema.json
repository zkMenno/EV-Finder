{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ev-finder.example/schema/ev.schema.json",
  "title": "EvSchema",
  "description": "EV Finder catalogue schema v0. Single source of truth: TS and Python types are generated from this file. Stable ids never change; slugs may.",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable id: lowercase, hyphen-separated."
    },
    "Country": {
      "type": "string",
      "enum": ["NL", "DE", "FR", "BE", "UK"]
    },
    "Currency": {
      "type": "string",
      "enum": ["EUR", "GBP"]
    },
    "Confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "Body": {
      "type": "string",
      "enum": ["hatchback", "sedan", "estate", "suv", "crossover", "coupe", "mpv", "cabrio"]
    },
    "Segment": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E", "F", "J-small", "J-medium", "J-large"]
    },
    "Drivetrain": {
      "type": "string",
      "enum": ["fwd", "rwd", "awd"]
    },
    "Era": {
      "type": "string",
      "enum": ["pre-2018", "2018-20", "2021-22", "2023-24", "2025+"]
    },
    "QualityTier": {
      "type": "string",
      "enum": ["checked", "sourced", "single-source"],
      "description": "checked = staff hand-checked; sourced = 2+ agreeing sources; single-source = one source only."
    },
    "RealRangeRung": {
      "type": "string",
      "enum": [
        "owner-data",
        "exact-test",
        "sibling-variant",
        "brand-body-drivetrain-ratio",
        "body-ratio"
      ],
      "description": "Which rung of the real-range fallback ladder produced the value (highest first)."
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      }
    },
    "ChangeMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "text"],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 2008,
          "maximum": 2035
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "licence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "licence": {
          "type": "string",
          "description": "SPDX id or licence name, e.g. CDLA-Permissive-2.0, CC0-1.0."
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "Make": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "make_id", "name", "slug"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "make_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/Id"
        },
        "segment": {
          "$ref": "#/$defs/Segment"
        },
        "body": {
          "$ref": "#/$defs/Body"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model_id", "name", "slug", "year_start"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "model_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/Id"
        },
        "year_start": {
          "type": "integer",
          "minimum": 2008,
          "maximum": 2035
        },
        "year_end": {
          "type": ["integer", "null"],
          "minimum": 2008,
          "maximum": 2035,
          "description": "null = still on sale."
        },
        "uncertain": {
          "type": "boolean",
          "default": false,
          "description": "Year boundaries not hand-checked yet."
        },
        "change_markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeMarker"
          }
        }
      }
    },
    "Variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generation_id", "name", "slug", "year_start"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "generation_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/$defs/Id"
        },
        "year_start": {
          "type": "integer",
          "minimum": 2008,
          "maximum": 2035
        },
        "year_end": {
          "type": ["integer", "null"],
          "minimum": 2008,
          "maximum": 2035
        },
        "drivetrain": {
          "$ref": "#/$defs/Drivetrain"
        },
        "platform_id": {
          "$ref": "#/$defs/Id"
        },
        "battery_pack_id": {
          "$ref": "#/$defs/Id"
        },
        "voltage": {
          "$ref": "#/$defs/VariantVoltage"
        },
        "charger_400v": {
          "$ref": "#/$defs/Charger400vBehaviour"
        }
      }
    },
    "MarketVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variant_id", "country"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "variant_id": {
          "$ref": "#/$defs/Id"
        },
        "country": {
          "$ref": "#/$defs/Country"
        },
        "local_name": {
          "type": "string"
        },
        "price_new": {
          "$ref": "#/$defs/Money"
        },
        "wltp_km": {
          "type": "number",
          "minimum": 0
        },
        "epa_km": {
          "type": "number",
          "minimum": 0
        },
        "drive_side": {
          "type": "string",
          "enum": ["lhd", "rhd"]
        },
        "on_sale_new": {
          "type": "boolean"
        }
      }
    },
    "FactField": {
      "type": "string",
      "enum": [
        "battery_kwh_net",
        "battery_kwh_gross",
        "wltp_range_km",
        "epa_range_km",
        "consumption_kwh_100km",
        "ac_kw",
        "dc_peak_kw",
        "dc_avg_10_80_kw",
        "power_kw",
        "accel_0_100_s",
        "top_speed_kmh",
        "boot_l",
        "frunk_l",
        "length_mm",
        "width_mm",
        "height_mm",
        "wheelbase_mm",
        "weight_kg",
        "towing_kg",
        "seats",
        "price_new",
        "real_range_km",
        "registered_count",
        "dc_curve",
        "dc_minutes_10_80",
        "dc_peak_kw_claim",
        "consumption_motorway_kwh_100km",
        "real_range_summer_km",
        "real_range_motorway_km",
        "real_range_winter_km",
        "voltage_nominal_v",
        "voltage_max_v",
        "chemistry_id",
        "cooling_id",
        "cell_format",
        "charger_400v_behaviour",
        "warranty_years",
        "warranty_km"
      ]
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_type",
        "subject_id",
        "field",
        "value",
        "unit",
        "source",
        "retrieved_at",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "subject_type": {
          "type": "string",
          "enum": ["model", "generation", "variant", "market_variant", "platform", "battery_pack"]
        },
        "subject_id": {
          "$ref": "#/$defs/Id"
        },
        "field": {
          "$ref": "#/$defs/FactField"
        },
        "value": {
          "oneOf": [
            {
              "type": ["number", "string", "boolean"]
            },
            {
              "$ref": "#/$defs/ChargeCurve"
            }
          ],
          "description": "Scalar, or a ChargeCurve when field = dc_curve."
        },
        "unit": {
          "type": "string",
          "description": "Metric unit (kWh, km, kW, kWh/100km, l, mm, kg, s, km/h, count) or currency code for prices."
        },
        "country": {
          "$ref": "#/$defs/Country",
          "description": "Set for market-specific facts (prices, registrations)."
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "source_record": {
          "type": "string",
          "description": "Pointer to the raw record, e.g. a file path or row key."
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "observed_at": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "claim": {
          "type": "boolean",
          "description": "true when the value is a maker claim rather than measured."
        }
      }
    },
    "FieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "confidence"],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived": {
          "type": "boolean",
          "description": "true when computed by us from other facts."
        },
        "note": {
          "type": "string"
        },
        "agreeing_sources": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of independent sources agreeing within the field tolerance (UI badge 'N sources agree')."
        },
        "estimate": {
          "type": "boolean",
          "description": "true when the value comes from a model/ratio rather than any source."
        }
      }
    },
    "PublishedVariant": {
      "type": "object",
      "description": "One wide row per variant per release. What the web app reads.",
      "additionalProperties": false,
      "required": [
        "release",
        "variant_id",
        "variant_name",
        "generation_id",
        "generation_name",
        "model_id",
        "model_name",
        "make_id",
        "make_name",
        "year_start",
        "era",
        "quality_tier",
        "provenance"
      ],
      "properties": {
        "release": {
          "type": "integer",
          "minimum": 1
        },
        "variant_id": {
          "$ref": "#/$defs/Id"
        },
        "variant_name": {
          "type": "string"
        },
        "generation_id": {
          "$ref": "#/$defs/Id"
        },
        "generation_name": {
          "type": "string"
        },
        "generation_uncertain": {
          "type": "boolean"
        },
        "model_id": {
          "$ref": "#/$defs/Id"
        },
        "model_name": {
          "type": "string"
        },
        "make_id": {
          "$ref": "#/$defs/Id"
        },
        "make_name": {
          "type": "string"
        },
        "year_start": {
          "type": "integer"
        },
        "year_end": {
          "type": ["integer", "null"]
        },
        "era": {
          "$ref": "#/$defs/Era"
        },
        "segment": {
          "$ref": "#/$defs/Segment"
        },
        "body": {
          "$ref": "#/$defs/Body"
        },
        "drivetrain": {
          "$ref": "#/$defs/Drivetrain"
        },
        "battery_kwh_net": {
          "type": ["number", "null"]
        },
        "wltp_range_km": {
          "type": ["number", "null"]
        },
        "consumption_kwh_100km": {
          "type": ["number", "null"]
        },
        "ac_kw": {
          "type": ["number", "null"]
        },
        "dc_peak_kw": {
          "type": ["number", "null"]
        },
        "dc_avg_10_80_kw": {
          "type": ["number", "null"]
        },
        "ac_km_per_h": {
          "type": ["number", "null"],
          "description": "Derived: ac_kw / consumption * 100."
        },
        "dc_km_per_10min": {
          "type": ["number", "null"],
          "description": "Derived: km added in 10 min at motorway consumption (dc_avg_10_80_kw / motorway consumption * 100 / 6)."
        },
        "real_range_km": {
          "type": ["number", "null"]
        },
        "real_range_rung": {
          "oneOf": [
            {
              "$ref": "#/$defs/RealRangeRung"
            },
            {
              "type": "null"
            }
          ]
        },
        "power_kw": {
          "type": ["number", "null"]
        },
        "accel_0_100_s": {
          "type": ["number", "null"]
        },
        "boot_l": {
          "type": ["number", "null"]
        },
        "length_mm": {
          "type": ["number", "null"]
        },
        "weight_kg": {
          "type": ["number", "null"]
        },
        "towing_kg": {
          "type": ["number", "null"]
        },
        "seats": {
          "type": ["integer", "null"]
        },
        "on_sale_new": {
          "type": "boolean"
        },
        "price_new": {
          "type": "object",
          "description": "New price per country (local currency).",
          "propertyNames": {
            "$ref": "#/$defs/Country"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Money"
          }
        },
        "registered_count_nl": {
          "type": ["integer", "null"],
          "description": "RDW registrations, counted at generation level."
        },
        "quality_tier": {
          "$ref": "#/$defs/QualityTier"
        },
        "change_markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeMarker"
          }
        },
        "provenance": {
          "type": "object",
          "description": "Field name → where the value came from. Every non-null number above must have an entry.",
          "additionalProperties": {
            "$ref": "#/$defs/FieldProvenance"
          }
        },
        "dc_minutes_10_80": {
          "type": ["number", "null"],
          "description": "Minutes 10-80%."
        },
        "dc_km_per_20min": {
          "type": ["number", "null"],
          "description": "Derived: km added in 20 min at motorway consumption. Used for the DC ranking."
        },
        "dc_peak_held_min": {
          "type": ["number", "null"],
          "description": "Minutes above 90% of peak."
        },
        "consumption_motorway_kwh_100km": {
          "type": ["number", "null"],
          "description": "Motorway consumption used for km-in-N-minutes."
        },
        "dc_curve_status": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["measured", "estimated", "default"]
            },
            {
              "type": "null"
            }
          ]
        },
        "dc_peak_kw_is_claim": {
          "type": "boolean",
          "description": "true when dc_peak_kw is a maker claim, not measured."
        },
        "platform_id": {
          "type": ["string", "null"]
        },
        "platform_name": {
          "type": ["string", "null"]
        },
        "battery_pack_id": {
          "type": ["string", "null"]
        },
        "chemistry_id": {
          "type": ["string", "null"],
          "description": "Taxonomy id or 'not-disclosed'."
        },
        "cooling_id": {
          "type": ["string", "null"]
        },
        "cell_format": {
          "type": ["string", "null"]
        },
        "voltage_nominal_v": {
          "type": ["number", "null"]
        },
        "voltage_max_v": {
          "type": ["number", "null"]
        },
        "voltage_label": {
          "type": ["string", "null"]
        },
        "voltage_class_id": {
          "type": ["string", "null"],
          "description": "Derived class id, or 'not-disclosed'."
        },
        "voltage_switchable": {
          "type": ["boolean", "null"]
        },
        "charger_400v_mode": {
          "type": ["string", "null"],
          "enum": ["native", "booster", "limited", "not-disclosed", null]
        },
        "charger_400v_kw": {
          "type": ["number", "null"]
        },
        "fast_on_400v": {
          "type": ["boolean", "null"],
          "description": "Derived: native 400 V car, or booster/limited at >= 50 kW on 400 V chargers."
        },
        "charge_100_daily": {
          "type": ["boolean", "null"],
          "description": "From the chemistry row."
        }
      }
    },
    "Catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "generated_at", "sources", "rows"],
      "properties": {
        "release": {
          "type": "integer",
          "minimum": 1
        },
        "generated_at": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "generations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Generation"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublishedVariant"
          }
        },
        "taxonomy": {
          "$ref": "#/$defs/Taxonomy"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Platform"
          }
        },
        "battery_packs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BatteryPack"
          }
        }
      }
    },
    "ChargeCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "status"],
      "description": "DC charge curve: list of (state of charge %, kW) points plus test conditions.",
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "status": {
          "type": "string",
          "enum": ["measured", "estimated", "default"]
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "battery_temp_c": {
              "type": "number"
            },
            "preconditioned": {
              "type": "boolean"
            },
            "ambient_temp_c": {
              "type": "number"
            },
            "charger_kw": {
              "type": "number"
            },
            "software_version": {
              "type": "string"
            }
          }
        }
      }
    },
    "TaxonomyStatus": {
      "type": "string",
      "enum": ["mainstream", "emerging", "niche", "legacy", "experimental"]
    },
    "VoltageClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "min_v", "max_v", "status"],
      "description": "Row in data/taxonomy/voltage_classes.yaml. Data, not an enum: add a row, no code change.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "object",
          "description": "Display label. Keyed by language (en, nl, de, fr, es, it); en required.",
          "required": ["en"],
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": ["en", "nl", "de", "fr", "es", "it"]
          }
        },
        "min_v": {
          "type": "number"
        },
        "max_v": {
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/TaxonomyStatus"
        },
        "explainer": {
          "type": "object",
          "description": "Plain-language explainer. Keyed by language (en, nl, de, fr, es, it); en required.",
          "required": ["en"],
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": ["en", "nl", "de", "fr", "es", "it"]
          }
        }
      }
    },
    "Chemistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "label", "status", "charge_100_daily"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "family": {
          "type": "string"
        },
        "label": {
          "type": "object",
          "description": "Display label. Keyed by language (en, nl, de, fr, es, it); en required.",
          "required": ["en"],
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": ["en", "nl", "de", "fr", "es", "it"]
          }
        },
        "status": {
          "$ref": "#/$defs/TaxonomyStatus"
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One pro. Keyed by language (en, nl, de, fr, es, it); en required.",
            "required": ["en"],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "enum": ["en", "nl", "de", "fr", "es", "it"]
            }
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One con. Keyed by language (en, nl, de, fr, es, it); en required.",
            "required": ["en"],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "enum": ["en", "nl", "de", "fr", "es", "it"]
            }
          }
        },
        "care_tips": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "One tip. Keyed by language (en, nl, de, fr, es, it); en required.",
            "required": ["en"],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "enum": ["en", "nl", "de", "fr", "es", "it"]
            }
          }
        },
        "charge_100_daily": {
          "type": ["boolean", "null"],
          "description": "true = maker guidance allows charging to 100% daily (typical for LFP). null = unclear."
        },
        "first_year": {
          "type": ["integer", "null"],
