{
  "name": "@ev/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/listings.mjs && node scripts/charging-links.mjs && node scripts/sources.mjs && next dev",
    "build": "node scripts/listings.mjs && node scripts/charging-links.mjs && node scripts/sources.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "listings": "node scripts/listings.mjs",
    "sources": "node scripts/sources.mjs",
    "charging-links": "node scripts/charging-links.mjs",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@ev/schema": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "js-yaml": "4.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
