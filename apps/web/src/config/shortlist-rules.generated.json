      "calibration": "Back-tested on Menno's 'EVs top tier' tab (research/R-32): 80% band match on 30 cars",
      "bands": {
        "800v": {
          "shortlist": 68,
          "consider": 63
        },
        "400v": {
          "shortlist": 52,
          "consider": 45
